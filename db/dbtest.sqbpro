<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="dbtest.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="1"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2309"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="barang" custom_title="0" dock_id="2" table="4,6:mainbarang"/><table title="barang" custom_title="0" dock_id="3" table="4,6:mainbarang"/><dock_state state=""/><default_encoding codec=""/><browse_table_settings><table schema="main" name="barang" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="65"/><column index="2" value="167"/><column index="3" value="127"/><column index="4" value="79"/><column index="5" value="35"/><column index="6" value="93"/><column index="7" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">INSERT INTO barang (nama_barang, kategori, harga, stok, id_user_admin)
WITH RECURSIVE cnt(x) AS (
   SELECT 1
   UNION ALL
   SELECT x + 1 FROM cnt LIMIT 100000
)
SELECT 
    'Produk Sampel ke-' || x, 
    CASE (x % 5) 
        WHEN 0 THEN 'Elektronik'
        WHEN 1 THEN 'Pakaian'
        WHEN 2 THEN 'Kebutuhan Rumah'
        WHEN 3 THEN 'Otomotif'
        ELSE 'Hobi'
    END,
    (10000 + (x * 500)), -- Harga bervariasi mulai dari 10.500
    (x % 50) + 1,        -- Stok bervariasi antara 1 - 50
    1                    -- id_user_admin (Budi)
FROM cnt;</sql><current_tab id="0"/></tab_sql></sqlb_project>
